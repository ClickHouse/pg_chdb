-- Clean up after any previous failed run.
SET client_min_messages = error;
DROP ROLE IF EXISTS chdb_cloud;
DROP ROLE IF EXISTS "chDB Cloud";
DROP ROLE IF EXISTS chdb_nobody;
RESET client_min_messages;
CREATE ROLE chdb_cloud;
CREATE ROLE "chDB Cloud";
CREATE ROLE chdb_nobody;
PREPARE show_roles AS
    SELECT 'chdb' AS extension,
        current_setting('chdb.host_credentials_roles') AS roles
    UNION SELECT 'chdb_hook',
        current_setting('chdb_hook.host_credentials_roles')
    ORDER BY extension;
-- No role may use host credentials by default.
EXECUTE show_roles;
 extension | roles 
-----------+-------
 chdb      | 
 chdb_hook | 
(2 rows)

-- Name roles, quoted where they need it.
SET chdb.host_credentials_roles = 'chdb_cloud, "chDB Cloud"';
SET chdb_hook.host_credentials_roles = '"chDB Cloud"';
EXECUTE show_roles;
 extension |          roles           
-----------+--------------------------
 chdb      | chdb_cloud, "chDB Cloud"
 chdb_hook | "chDB Cloud"
(2 rows)

-- Reject lists that do not parse.
SET chdb.host_credentials_roles = '"chDB Cloud';
ERROR:  invalid value for parameter "chdb.host_credentials_roles": ""chDB Cloud"
DETAIL:  List syntax is invalid.
SET chdb_hook.host_credentials_roles = 'chdb_cloud,,chdb_nobody';
ERROR:  invalid value for parameter "chdb_hook.host_credentials_roles": "chdb_cloud,,chdb_nobody"
DETAIL:  List syntax is invalid.
-- Reject roles that do not exist.
SET chdb.host_credentials_roles = 'no_such_role';
ERROR:  invalid value for parameter "chdb.host_credentials_roles": "no_such_role"
DETAIL:  Role "no_such_role" does not exist.
SET chdb_hook.host_credentials_roles = 'chdb_cloud, no_such_role';
ERROR:  invalid value for parameter "chdb_hook.host_credentials_roles": "chdb_cloud, no_such_role"
DETAIL:  Role "no_such_role" does not exist.
SET chdb.host_credentials_roles = 'chdb cloud';
ERROR:  invalid value for parameter "chdb.host_credentials_roles": "chdb cloud"
DETAIL:  List syntax is invalid.
EXECUTE show_roles;
 extension |          roles           
-----------+--------------------------
 chdb      | chdb_cloud, "chDB Cloud"
 chdb_hook | "chDB Cloud"
(2 rows)

-- A setting stored for a later session only notes a role that does not exist.
ALTER ROLE chdb_nobody SET chdb.host_credentials_roles = 'no_such_role';
NOTICE:  role "no_such_role" does not exist
ALTER ROLE chdb_nobody RESET chdb.host_credentials_roles;
-- Only a superuser may name the roles.
SET ROLE chdb_nobody;
SET chdb.host_credentials_roles = 'chdb_nobody';
ERROR:  permission denied to set parameter "chdb.host_credentials_roles"
SET chdb_hook.host_credentials_roles = 'chdb_nobody';
ERROR:  permission denied to set parameter "chdb_hook.host_credentials_roles"
RESET chdb.host_credentials_roles;
ERROR:  permission denied to set parameter "chdb.host_credentials_roles"
RESET chdb_hook.host_credentials_roles;
ERROR:  permission denied to set parameter "chdb_hook.host_credentials_roles"
RESET ROLE;
EXECUTE show_roles;
 extension |          roles           
-----------+--------------------------
 chdb      | chdb_cloud, "chDB Cloud"
 chdb_hook | "chDB Cloud"
(2 rows)

-- Empty the lists.
SET chdb.host_credentials_roles = '';
RESET chdb_hook.host_credentials_roles;
EXECUTE show_roles;
 extension | roles 
-----------+-------
 chdb      | 
 chdb_hook | 
(2 rows)

DROP ROLE chdb_cloud;
DROP ROLE "chDB Cloud";
DROP ROLE chdb_nobody;
-- No AWS role to assume by default.
SHOW chdb_hook.s3_role_arn;
 chdb_hook.s3_role_arn 
-----------------------
 
(1 row)

-- Name a role, in any AWS partition.
SET chdb_hook.s3_role_arn = 'arn:aws:iam::123456789012:role/loader';
SHOW chdb_hook.s3_role_arn;
         chdb_hook.s3_role_arn         
---------------------------------------
 arn:aws:iam::123456789012:role/loader
(1 row)

SET chdb_hook.s3_role_arn = 'arn:aws-us-gov:iam::123456789012:role/path/to/Loader+=,.@_-';
SHOW chdb_hook.s3_role_arn;
                    chdb_hook.s3_role_arn                    
-------------------------------------------------------------
 arn:aws-us-gov:iam::123456789012:role/path/to/Loader+=,.@_-
(1 row)

-- Reject values that are not an IAM role ARN.
SET chdb_hook.s3_role_arn = 'loader';
ERROR:  invalid value for parameter "chdb_hook.s3_role_arn": "loader"
DETAIL:  Expected the form arn:aws:iam::123456789012:role/name.
SET chdb_hook.s3_role_arn = 'arn:aws:iam::123456789012:user/loader';
ERROR:  invalid value for parameter "chdb_hook.s3_role_arn": "arn:aws:iam::123456789012:user/loader"
DETAIL:  Expected the form arn:aws:iam::123456789012:role/name.
SET chdb_hook.s3_role_arn = 'arn:aws:iam::1234:role/loader';
ERROR:  invalid value for parameter "chdb_hook.s3_role_arn": "arn:aws:iam::1234:role/loader"
DETAIL:  Expected the form arn:aws:iam::123456789012:role/name.
SET chdb_hook.s3_role_arn = 'arn:aws:iam::123456789012:role/';
ERROR:  invalid value for parameter "chdb_hook.s3_role_arn": "arn:aws:iam::123456789012:role/"
DETAIL:  Expected the form arn:aws:iam::123456789012:role/name.
SET chdb_hook.s3_role_arn = 'arn:aws:iam::123456789012:role/it''s';
ERROR:  invalid value for parameter "chdb_hook.s3_role_arn": "arn:aws:iam::123456789012:role/it's"
DETAIL:  Expected the form arn:aws:iam::123456789012:role/name.
SET chdb_hook.s3_role_arn = 'arn:aws:s3:::bucket';
ERROR:  invalid value for parameter "chdb_hook.s3_role_arn": "arn:aws:s3:::bucket"
DETAIL:  Expected the form arn:aws:iam::123456789012:role/name.
SHOW chdb_hook.s3_role_arn;
                    chdb_hook.s3_role_arn                    
-------------------------------------------------------------
 arn:aws-us-gov:iam::123456789012:role/path/to/Loader+=,.@_-
(1 row)

-- Any role may set it, and it can be stored for a role or database.
CREATE ROLE chdb_nobody;
SET ROLE chdb_nobody;
SET chdb_hook.s3_role_arn = 'arn:aws:iam::123456789012:role/other';
SHOW chdb_hook.s3_role_arn;
        chdb_hook.s3_role_arn         
--------------------------------------
 arn:aws:iam::123456789012:role/other
(1 row)

RESET ROLE;
ALTER ROLE chdb_nobody SET chdb_hook.s3_role_arn = 'arn:aws:iam::123456789012:role/loader';
ALTER ROLE chdb_nobody SET chdb_hook.s3_role_arn = 'loader';
ERROR:  invalid value for parameter "chdb_hook.s3_role_arn": "loader"
DETAIL:  Expected the form arn:aws:iam::123456789012:role/name.
DROP ROLE chdb_nobody;
-- Empty it. chdb has no such setting, as chdb_query() takes the role in SQL.
SET chdb_hook.s3_role_arn = '';
SHOW chdb_hook.s3_role_arn;
 chdb_hook.s3_role_arn 
-----------------------
 
(1 row)

SHOW chdb.s3_role_arn;
